<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /> @* Character encoding (needed to show the rupee symbol correctly) *@
    <meta name="viewport" content="width=device-width, initial-scale=1" /> @* Makes the page mobile friendly *@
    <title>@ViewData["Title"] - Hospital Appointment System</title> @* Page title comes from each view *@
    @* Bootstrap CSS from a CDN for quick styling *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    @* Top navigation bar *@
    <nav class="navbar navbar-expand navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Hospital Appointment System</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Doctors</a></li> @* Link to doctor list *@
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Posts">Posts (API)</a></li> @* Link to async posts page *@
            </ul>
        </div>
    </nav>

    <div class="container">
        @RenderBody() @* The content of the current view is inserted here *@
    </div>
</body>
</html>
